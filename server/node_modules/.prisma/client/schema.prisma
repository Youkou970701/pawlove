generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Couple {
  id        String   @id @default(uuid())
  code      String   @unique
  createdAt DateTime @default(now())
  pet       Pet?
  tasks     Task[]
  answers   Answer[]
  photos    Photo[]
  diaries   Diary[]
}

model Pet {
  id          String    @id @default(uuid())
  coupleId    String    @unique
  couple      Couple    @relation(fields: [coupleId], references: [id])
  stage       String    @default("egg")
  name        String?
  warmth      Int       @default(0)
  hunger      Int       @default(100)
  happiness   Int       @default(100)
  cleanliness Int       @default(100)
  energy      Int       @default(100)
  hatchedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id        String   @id @default(uuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id])
  type      String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Answer {
  id       String  @id @default(uuid())
  coupleId String
  couple   Couple  @relation(fields: [coupleId], references: [id])
  question String
  userA    String?
  userB    String?
  date     String
}

model Photo {
  id       String  @id @default(uuid())
  coupleId String
  couple   Couple  @relation(fields: [coupleId], references: [id])
  url      String
  caption  String?
  date     String
}

model Diary {
  id       String @id @default(uuid())
  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id])
  mood     String
  content  String
  user     String
  date     String
}
